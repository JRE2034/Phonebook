def dateofbirth_():
    while True:
        try:
            ageq_ = int(input('How old are you?\n'))
            if ageq_ < 0:
                print ('Age invalid\n')
                continue
            elif ageq_ > 100:
                print ('You are too old\n')
                continue 
            break    
        except ValueError:
                    print ('Invalid: Please enter a number\n')
    return ageq_


def mobilenumber_():
